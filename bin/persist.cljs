#!/usr/bin/env nbb
(ns hayari.persist
  "hayari 流行 — その日の生観測を DataLad dataset へ預ける。

    nbb bin/persist.cljs [--data PATH] [--dataset PATH] [--day YYYY-MM-DD]

  ## なぜ預けるのか（再取得できるのに）

  Wikimedia の per-country pageviews は 2021-01-01 以降なら再取得できる（実測）。
  だから観測は原理的には cache である。それでも預けるのは:

  1. **上流は保持を約束していない。** 「取り直せる」は今日の観測であって契約ではない
  2. **観測した時点のバイトを残す。** 上流が値を訂正すると再取得は *今の答え* を
     返す。再現には *あの日そう見えた* が要る
  3. **2021 より前は誰にも取れない。** 境界の外は失えば終わり

  ## 資格情報について

  annex の S3 remote は AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY を要する。
  **launchd 下では kagi が使えない**（Keychain unlock prompt を出せない）ので、
  常駐から呼ぶときは `~/.gftd/hayari-s3-creds`（mode 600、2 行）から読む。
  plist は world-readable なので、そこに値を書いてはならない。"
  (:require ["fs" :as fs] ["path" :as path] ["child_process" :as cp]
            [clojure.edn :as edn] [clojure.string :as str]))

(def args (vec *command-line-args*))
(defn- flag [n d] (let [i (.indexOf args n)] (if (neg? i) d (nth args (inc i)))))

(def home (or js/process.env.HOME "/tmp"))
(def dataset (flag "--dataset" (path/join home ".gftd" "hayari-data")))
(def data    (flag "--data" (path/join home ".gftd" "hayari-tick" "data" "hayari.datoms.edn")))

(defn- creds []
  ;; env が既にあればそれを使う（対話実行）。無ければ mode 600 のファイル。
  (if (and js/process.env.AWS_ACCESS_KEY_ID js/process.env.AWS_SECRET_ACCESS_KEY)
    {:ok :env}
    (let [f (path/join home ".gftd" "hayari-s3-creds")]
      (if-not (fs/existsSync f)
        {:error (str "資格情報が無い: " f " (2 行: ACCESS_KEY_ID / SECRET_ACCESS_KEY)")}
        (let [[a s] (->> (str/split-lines (fs/readFileSync f "utf8"))
                         (remove str/blank?) (map str/trim))]
          (if (and a s)
            (do (set! (.-AWS_ACCESS_KEY_ID js/process.env) a)
                (set! (.-AWS_SECRET_ACCESS_KEY js/process.env) s)
                {:ok :file})
            {:error "資格情報ファイルが 2 行に満たない — 空の鍵で署名すると 403 になる"}))))))

(defn- sh [cmd cwd]
  (let [r (cp/spawnSync "/bin/sh" (clj->js ["-lc" cmd])
                        (clj->js {:cwd cwd :encoding "utf8" :timeout 900000}))]
    (if (zero? (or (.-status r) 0))
      {:ok (str/trim (or (.-stdout r) ""))}
      {:error {:status (.-status r) :err (str/trim (or (.-stderr r) ""))}})))

(defn- entry-exists?
  "その日のファイルが dataset に **登録されているか**。

  `fs/existsSync` は symlink を辿るので、annex 化されていて内容がローカルに無い
  ファイルを『無い』と答える。それを『まだ預けていない』と読むと、既に custody
  済みの日を書き直そうとし、dangling symlink への書き込みで ENOENT になる
  （実測 2026-08-11）。**ファイルの存在と内容の存在は別の問い。**"
  [f]
  (try (do (fs/lstatSync f) true) (catch :default _ false)))

(defn -main [& _]
  (cond
    (not (fs/existsSync dataset))
    (println (str "hayari persist: dataset が無い — " dataset
                  "\n  git clone git@github.com:cloud-itonami/hayari-data.git " dataset))

    (not (fs/existsSync data))
    (println (str "hayari persist: 観測が無い — " data))

    :else
    (let [c (creds)]
      (if-let [e (:error c)]
        (do (println (str "hayari persist: " e)) (set! (.-exitCode js/process) 1))
        (let [ds   (edn/read-string (fs/readFileSync data "utf8"))
              rows (filter :hayari/observed-on ds)
              days (sort (distinct (map :hayari/observed-on rows)))
              want (if-let [d (flag "--day" nil)] [d] days)
              wrote (atom 0)]
          (doseq [d want
                  :let [f (path/join dataset "raw" (str d ".datoms.edn"))
                        rs (filter #(= d (:hayari/observed-on %)) rows)]
                  ;; 既にある日は書き直さない。annex は内容が同じでも
                  ;; 書き直せば新しい key を作りうるので、無駄な object を増やさない。
                  :when (and (seq rs) (not (entry-exists? f)))]
            (fs/mkdirSync (path/dirname f) #js {:recursive true})
            (fs/writeFileSync
              f (str ";; hayari 流行 — " d " の生観測。GENERATED by src/hayari/collect.cljs。\n"
                     ";; 2021-01-01 以降は再取得できるが、ここが残すのは観測した時点のバイト。\n"
                     "[\n" (str/join "\n" (map pr-str rs)) "\n]\n"))
            (swap! wrote inc))
          (if (zero? @wrote)
            (println "hayari persist: 新しい日は無い — 何も預けない")
            (let [save (sh (str "datalad save -m " (pr-str (str "observe " (last want))) " >/dev/null 2>&1"
                                " && git annex copy --to kotobase --jobs 2")
                           dataset)]
              (if (:error save)
                (do (println (str "hayari persist: custody 失敗（次の tick で再試行）— "
                                  (:err (:error save))))
                    (set! (.-exitCode js/process) 1))
                (let [push (sh "git push -q origin main git-annex" dataset)]
                  (println (str "hayari persist: " @wrote " 日ぶんを預けた"
                                (when (:error push) " (push 失敗 — 次の tick で再試行)"))))))))))))

(apply -main args)
