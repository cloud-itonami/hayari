node_modules/
.nbb/
.cpcache/

# Collected observations are regenerated by src/hayari/collect.cljs on every run
# and would otherwise make every daily tick a large commit. data/kinds.edn and
# data/m49-regions.edn are inputs and ARE tracked.
#
# data/hayari-summary.edn is deliberately NOT here. It is the committed half —
# one entity per (country, day) plus the era coverage — and it is what
# manifest/edn-query.cljs loads. Without it in git, every observation row would
# go on carrying :source/dataset "hayari" for a query plane with nothing to read.
data/hayari.datoms.edn
data/hayari-xmile.edn
data/hayari-content.edn
data/hayari-entities.edn

# Per-day raw copies kept by `--mode collect` so a mirror that skipped a run
# can still archive them. Regenerated by the collector; never committed.
data/day-*.datoms.edn
