<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.gftd.hayari-mirror</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-lc</string>
  <string>exec nbb "$HOME/.gftd/hayari-mirror/bin/tick.cljs" --mode mirror --clone "$HOME/.gftd/hayari-mirror" --raw-from asher:.gftd/hayari-rad --pin-lag 4</string></array>
  <key>StartInterval</key>    <integer>900</integer>
  <key>RunAtLoad</key>        <false/>
  <key>StandardOutPath</key>  <string>/tmp/hayari-mirror.log</string>
  <key>StandardErrorPath</key><string>/tmp/hayari-mirror.log</string>
</dict></plist>
