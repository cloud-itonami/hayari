<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.gftd.hayari-node</string>
  <key>UserName</key><string>asher</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-lc</string>
  <string>exec /Users/asher/.radicle/bin/radicle-node</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/Users/asher</string>
    <key>RAD_PASSPHRASE</key><string></string></dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/hayari-radicle-node.log</string>
  <key>StandardErrorPath</key><string>/tmp/hayari-radicle-node.log</string>
</dict></plist>
